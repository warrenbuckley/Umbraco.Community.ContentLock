    "@web/dev-server-esbuild": "^1.0.5",
    "@web/test-runner": "^0.20.2",
    "@web/test-runner-playwright": "^0.11.1",
    "chalk": "^5.6.2",
    "cross-env": "^10.1.0",
    "msw": "^2.12.14",
    "node-fetch": "^3.3.2",
    "typescript": "^6.0.2",
    "vite": "^8.0.5"
  },
  "dependencies": {
    "@microsoft/signalr": "^10.0.0",
    "@warrenbuckley/audio-visualizer": "^1.0.0"
